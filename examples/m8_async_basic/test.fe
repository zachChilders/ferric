// M8 — async/await end-to-end: a single `async fn` with one `await`.
//
// After the M9 parser desugars `await expr` to
// `perform Async::Suspend(future: expr)` and `async fn fetch(...) -> T`
// to `fn fetch(...) -> Eff<[Async], T>`, the M8 host-side `block_on`
// helper is no longer needed: the default `Async` handler installed by
// the VM resolves the operand of `Async::Suspend` directly. The
// surrounding `async { ... }` block is kept so the parser's fast-path
// rule (`await` only inside an async context) still accepts the await.
async fn fetch(url: Str) -> Str { url }

let got: Str = async { await fetch(url: "hello world") }
println(s: got)
