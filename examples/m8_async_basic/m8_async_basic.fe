// M8 — async/await end-to-end: a single `async fn` with one `await`.
//
// `fetch` returns `Async<Str>`. `block_on` is the host-side runner that
// drives an `Async<T>` to completion synchronously — needed because
// top-level `await` is a parse error (the parser only allows it inside
// an `async fn` body or `async { ... }` block).

async fn fetch(url: Str) -> Str { url }

let task: Async<Str> = async { await fetch(url: "hello world") }
let got: Str = block_on(task: task)
println(s: got)
