// M10 Task 5: struct destructuring `let Point { x, y } = ...` binds the
// named fields of the struct directly into local variables.

struct Point {
    x: Int,
    y: Int,
}

fn make_point() -> Point {
    Point { x: 3, y: 7 }
}

let Point { x, y } = make_point()
println(s: int_to_str(n: x))
println(s: int_to_str(n: y))
println(s: int_to_str(n: x + y))
