// M8 — true parallelism: two spawned tasks run on separate OS threads.
//
// Each `slow_task(n)` does `await sleep(ms: 500)` then returns `n`. After
// M9 the parser desugars `await sleep(...)` into
// `perform Async::Suspend(future: sleep(...))`; the default `Async`
// handler installed by the VM resolves the suspended future. `spawn`
// moves the work onto an OS worker thread. Both spawned tasks sleep
// concurrently, so the wall clock measures ~500ms — not the ~1000ms a
// sequential implementation would take. `join` collects both results.

async fn slow_task(n: Int) -> Int {
    await sleep(ms: 500)
    n
}

let h1 = spawn(task: slow_task(n: 1))
let h2 = spawn(task: slow_task(n: 2))

let pair = join(a: h1, b: h2)
match pair {
    (a, b) => println(s: int_to_str(n: a + b))
}
